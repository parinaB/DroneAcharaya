# =============================================================================
# DroneAcharaya — repo-wide ignore rules.
#
# Single source of truth for the whole monorepo (backend, frontend, ml,
# simulation, data). There is deliberately no second .gitignore inside
# frontend/ — create-next-app's version was folded in here so that all rules
# live in one place.
#
# Note on negations: a rule ending in /** excludes a directory's *contents*
# but not the directory itself, which is what lets the !… lines below
# re-include specific files. Excluding the directory outright (e.g.
# `node_modules/`) makes anything inside it unreachable, and no negation can
# bring it back.
# =============================================================================

# -----------------------------------------------------------------------------
# Secrets and environment
# Committing a real .env is the single most expensive mistake available in this
# repo, so the patterns are broad and the *.example templates are re-included
# explicitly — those are documentation and must stay tracked.
# -----------------------------------------------------------------------------
.env
.env.*
*.env
!.env.example
!.env.*.example
!*.env.example

# Credentials and key material
*.pem
*.key
*.pfx
*.p12
*.keystore
*.jks
credentials.json
service-account*.json
.aws/
.netrc

# -----------------------------------------------------------------------------
# Python (backend/, ml/)
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# Local SQLite dev DB (backend/app/core/config.py's database_url default) --
# never the real Supabase Postgres, just a throwaway local file.
backend/dev.db

# Packaging / distribution
build/
dist/
sdist/
wheels/
*.egg
*.egg-info/
.eggs/
MANIFEST

# Virtual environments
.venv/
venv/
ENV/
env/
.python-version

# Test, coverage and type-check caches
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
.hypothesis/
.mypy_cache/
.dmypy.json
.pyre/
.ruff_cache/
.pytype/

# Jupyter / IPython — notebooks are fine to commit, their checkpoints are not
.ipynb_checkpoints/
profile_default/
ipython_config.py

# -----------------------------------------------------------------------------
# Node / Next.js (frontend/)
# -----------------------------------------------------------------------------
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js build output
.next/
out/
.vercel
next-env.d.ts

# TypeScript incremental build info
*.tsbuildinfo

# Frontend test coverage
frontend/coverage/

# Package-manager debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# ESLint / Prettier caches
.eslintcache
.prettiercache

# -----------------------------------------------------------------------------
# Data (data/)
# raw/ and processed/ are regenerable from the simulation, so they stay out of
# git; their READMEs and .gitkeep files are tracked. data/sample_runs/ is NOT
# ignored — those committed fixtures are what the tests and the demo depend on.
# -----------------------------------------------------------------------------
data/raw/**
data/processed/**
!data/raw/README.md
!data/raw/.gitkeep
!data/processed/README.md
!data/processed/.gitkeep

# Bulk data formats, wherever they appear outside the tracked sample runs.
# data/sample_runs/*.csv is re-included below so the fixtures survive.
*.parquet
*.feather
*.h5
*.hdf5
*.tfrecord
!data/sample_runs/**

# Model weight formats, wherever they land -- unignored file-by-file in the
# ml/artifacts/ section below where a specific file is a real runtime
# dependency; everywhere else (scratch checkpoints, other versions, other
# folders entirely) they stay ignored by default. Must come BEFORE the
# ml/artifacts/ allow-list below: gitignore applies rules in file order, so a
# broad *.pt/*.joblib rule appearing AFTER a specific !unignore would win and
# silently re-ignore it.
*.pt
*.pth
*.ckpt
*.onnx
*.pkl
*.joblib
*.safetensors

# -----------------------------------------------------------------------------
# ML artifacts (ml/artifacts/)
# Everything is gitignored by default (training scratch, exploratory
# checkpoints, per-run experiment dirs), EXCEPT the exact files
# backend/app/core/model_loader.py reads at runtime for the versions it's
# pinned to (backend/app/core/config.py's *_version settings) -- those are
# small (~16MB total) and committed directly, no Git LFS, so `git clone` +
# `uvicorn` works with zero out-of-band artifact-fetch step, including on
# Render. Anything NOT in model_loader.py's read list (evaluation exports
# like validation_predictions.csv, scratch/experiment checkpoints, other
# versions not yet wired) stays gitignored -- distribute those out of band
# (see ml/artifacts/README.md). Bump the allow-list below when
# config.py's *_version defaults move to a new version.
# -----------------------------------------------------------------------------
ml/artifacts/**
!ml/artifacts/README.md
!ml/artifacts/.gitkeep

!ml/artifacts/lstm_rul/
!ml/artifacts/lstm_rul/v1/
ml/artifacts/lstm_rul/v1/*
!ml/artifacts/lstm_rul/v1/lstm_best.pt
!ml/artifacts/lstm_rul/v1/scaler.joblib
!ml/artifacts/lstm_rul/v1/engine_state_encoder.joblib
!ml/artifacts/lstm_rul/v1/rul_scale_seconds.json
!ml/artifacts/lstm_rul/v1/metadata.json

!ml/artifacts/xgboost_classifier/
!ml/artifacts/xgboost_classifier/v1/
ml/artifacts/xgboost_classifier/v1/*
!ml/artifacts/xgboost_classifier/v1/xgboost_cht_c3.json
!ml/artifacts/xgboost_classifier/v1/xgboost_bearing_vibration.json
!ml/artifacts/xgboost_classifier/v1/metadata.json

!ml/artifacts/autoencoder/
!ml/artifacts/autoencoder/v3/
ml/artifacts/autoencoder/v3/*
!ml/artifacts/autoencoder/v3/model.pt
!ml/artifacts/autoencoder/v3/scaler.json
!ml/artifacts/autoencoder/v3/threshold.json
!ml/artifacts/autoencoder/v3/metadata.json
# validation_predictions.csv (~750MB, evaluation-only) stays ignored

!ml/artifacts/digital_twin/
!ml/artifacts/digital_twin/v3/
ml/artifacts/digital_twin/v3/*
!ml/artifacts/digital_twin/v3/*.joblib
!ml/artifacts/digital_twin/v3/metadata.json

# Experiment tracking / local run output
mlruns/
wandb/
lightning_logs/
runs/
.tensorboard/

